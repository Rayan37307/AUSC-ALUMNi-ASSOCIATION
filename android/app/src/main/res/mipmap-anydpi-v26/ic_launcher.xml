<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon for Android 8.0 (API 26) and above. Android masks
     the foreground into its own shape, so the logo is drawn inside the 66%
     safe zone (see drawable-<density>/ic_launcher_foreground.png) and the
     background is a flat white. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>